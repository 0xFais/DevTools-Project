<UserControl x:Class="DevTools.App.Views.ScoopWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DevTools.App.Views" xmlns:app="clr-namespace:DevTools.App" Loaded="LoadedView" DataContextChanged="ContextChanged" PreviewKeyDown="KeyPressed">
 <UserControl.Resources><app:InverseBooleanConverter x:Key="EnabledSetup"/><local:ScoopIconConverter x:Key="ScoopIcon"/><BooleanToVisibilityConverter x:Key="ScoopVisible"/>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="item" Padding="14,9" Background="{DynamicResource PanelBackground}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="item" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid">
   <EventSetter Event="SizeChanged" Handler="GridResized"/>
   <Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="RowBackground" Value="{DynamicResource PanelBackground}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource SidebarBackground}"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Extended"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="MinHeight" Value="160"/><Setter Property="Height" Value="200"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SidebarBackground}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="10,11"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True" Margin="0,0,0,12"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="tab" Padding="13,10" Margin="0,0,7,0" CornerRadius="6" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="tab" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="FontSize" Value="11"/></Style>
 <DataTemplate x:Key="PackageEditor"><StackPanel Margin="0,12,0,0"><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><WrapPanel Margin="0,12,0,0"><Button Content="Full details / size" Command="{Binding Commands[Details]}" Style="{StaticResource SmallAction}"/><Button Content="Open folder" Command="{Binding Commands[OpenFolder]}" Style="{StaticResource SmallAction}"/><Button Content="Homepage" Command="{Binding Commands[Homepage]}" Style="{StaticResource SmallAction}"/><ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" Width="150" Margin="0,0,8,7"/><Button Content="Switch version" Command="{Binding Commands[SwitchVersion]}" Style="{StaticResource SmallAction}"/></WrapPanel></StackPanel></DataTemplate><DataTemplate x:Key="PathEditor"><StackPanel Margin="0,12,0,0"><TextBlock Text="Select an app above. One folder per line: relative folders are managed by Scoop; absolute folders are added to your user PATH." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding PathEntries,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="190" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10" AutomationProperties.Name="Per-app PATH entries"/><WrapPanel><Button Content="Add folder" Command="{Binding Commands[AddPathFolder]}" Style="{StaticResource SmallAction}"/><Button Content="Save rules" Command="{Binding Commands[SavePaths]}" Style="{StaticResource SmallAction}"/><Button Content="Reapply saved rules" Command="{Binding Commands[SyncPaths]}" Style="{StaticResource SmallAction}"/><Button Content="Import legacy PATH rules" Command="{Binding Commands[ImportRules]}" Style="{StaticResource SmallAction}"/></WrapPanel></StackPanel></DataTemplate></UserControl.Resources>
 <Grid DataContext="{Binding ScoopWorkspace}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,14"><TextBlock Text="Scoop manager" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,18,0"/><Button Content="Locate Scoop…" Command="{Binding Commands[ChooseRoot]}" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox IsReadOnly="True" Text="{Binding Root,UpdateSourceTrigger=PropertyChanged}" ToolTip="Scoop root folder" AutomationProperties.Name="Scoop root folder"/></DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"><DockPanel><Button DockPanel.Dock="Right" Content="Check again" Command="{Binding Commands[CheckSetup]}" Margin="8,0,0,0" IsEnabled="{Binding IsRunning,Converter={StaticResource EnabledSetup}}"/><Button DockPanel.Dock="Right" Content="Add to PATH" Command="{Binding Commands[AddScoopPath]}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Visibility="{Binding NeedsPath,Converter={StaticResource ScoopVisible}}" IsEnabled="{Binding IsRunning,Converter={StaticResource EnabledSetup}}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SetupTitle}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding SetupMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowInstall,Converter={StaticResource ScoopVisible}}"><Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="24" VerticalAlignment="Top"><StackPanel IsEnabled="{Binding IsRunning,Converter={StaticResource EnabledSetup}}"><TextBlock Text="Install Scoop" FontSize="21"/><TextBlock Text="Manage packages with Scoop, or locate an installation you already have." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,22"/><TextBlock Text="Install location" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding Commands[BrowseInstallLocation]}" Margin="10,0,0,0"/><TextBox Text="{Binding InstallLocation,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Scoop install location"/></DockPanel><WrapPanel Margin="0,22,0,0"><Button Content="Install Scoop" Command="{Binding Commands[InstallScoop]}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/><Button Content="Locate existing installation" Command="{Binding Commands[ChooseRoot]}" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="Progress appears in Activity. Existing PATH entries are preserved." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></ScrollViewer><TabControl Grid.Row="2" SelectedIndex="{Binding Tab}" Visibility="{Binding HasInstallation,Converter={StaticResource ScoopVisible}}">
   <TabItem Header="Installed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Margin="0,0,10,0"><TextBox x:Name="FilterBox" Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter apps by name, bucket, held or update" ToolTip="Filter by name, version, bucket, held or update"/><TextBlock Text="Filter apps: name, bucket, held, update…" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Refresh" Command="{Binding Commands[Refresh]}" Margin="0,0,8,0"/><Button Content="Update all" Command="{Binding Commands[UpdateAll]}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
<Button Content="Maintenance ▾" Click="OpenActionMenu" AutomationProperties.Name="Scoop maintenance">
 <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
  <MenuItem Header="Update Scoop and buckets" Command="{Binding Commands[UpdateBuckets]}"/>
  <MenuItem Header="Clean old versions…" Command="{Binding Commands[Cleanup]}"/>
  <Separator/>
  <MenuItem Header="View download cache" Command="{Binding Commands[ShowCache]}"/>
  <MenuItem Header="Clear download cache…" Command="{Binding Commands[ClearCache]}"/>
  <Separator/>
  <MenuItem Header="Reset all apps…" Command="{Binding Commands[ResetAll]}"/>
  <MenuItem Header="Reapply saved PATH rules…" Command="{Binding Commands[SyncPaths]}"/>
  <MenuItem Header="Import legacy PATH rules…" Command="{Binding Commands[ImportRules]}"/>
 </ContextMenu></Button.ContextMenu>
</Button></StackPanel></Grid>
    <WrapPanel Grid.Row="1" Margin="0,0,0,4">
     <StackPanel Margin="0,0,20,0">
      <TextBlock Text="Selected apps" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,7"/>
      <WrapPanel>
       <Button Content="Update selected" Command="{Binding Commands[update]}" Style="{StaticResource SmallAction}"/>
       <Button Content="Reset selected" Command="{Binding Commands[reset]}" Style="{StaticResource SmallAction}" ToolTip="Recreate shortcuts, shims and PATH for the selected apps"/>
       <Button Content="Updates ▾" Click="OpenActionMenu" Style="{StaticResource SmallAction}">
        <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
         <MenuItem Header="Hold updates" Command="{Binding Commands[hold]}"/>
         <MenuItem Header="Allow updates" Command="{Binding Commands[unhold]}"/>
        </ContextMenu></Button.ContextMenu>
       </Button>
       <Button Content="Uninstall selected…" Command="{Binding Commands[uninstall]}" Style="{StaticResource SmallAction}"/>
      </WrapPanel>
     </StackPanel>
     <StackPanel>
      <TextBlock Text="App tools" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,7"/>
      <WrapPanel>
       <Button Content="Package details…" Click="OpenDetails" Style="{StaticResource SmallAction}"/>
       <Button Content="Add / edit PATH…" Click="OpenPaths" Style="{StaticResource SmallAction}"/>
       <Button Content="More ▾" Click="OpenActionMenu" Style="{StaticResource SmallAction}">
        <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
         <MenuItem Header="Open app folder" Command="{Binding Commands[OpenFolder]}"/>
         <MenuItem Header="Open homepage" Command="{Binding Commands[Homepage]}"/>
         <MenuItem Header="Switch installed version…" Click="OpenDetails"/>
        </ContextMenu></Button.ContextMenu>
       </Button>
      </WrapPanel>
     </StackPanel>
    </WrapPanel><DataGrid Grid.Row="2" x:Name="InstalledGrid" Height="Auto" MinHeight="100" ItemsSource="{Binding Installed}" SelectedItem="{Binding Selected}" SelectionChanged="InstalledSelection" MouseDoubleClick="DetailsClick" AutomationProperties.Name="Installed Scoop packages">
     <DataGrid.ContextMenu><ContextMenu Opened="ContextOpened"><MenuItem Header="Details and versions" Click="ContextDetails"/><MenuItem Header="Open app folder" Click="ContextFolder"/><MenuItem Header="Copy name" Click="CopyName"/></ContextMenu></DataGrid.ContextMenu>
     <DataGrid.Columns><DataGridTemplateColumn Header="App" SortMemberPath="Name" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image local:ScoopAsyncIcon.Directory="{Binding Directory}" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*"/><DataGridTextColumn Header="Bucket" Binding="{Binding Bucket}" Width="*"/><DataGridTextColumn Header="Held" Binding="{Binding HeldLabel}" Width="0.6*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.6*"/></DataGrid.Columns>
    </DataGrid>
    
    
    
   </Grid></TabItem>
   <TabItem Header="Search"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Margin="0,0,10,0"><TextBox x:Name="SearchBox" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchKey" AutomationProperties.Name="Search package names in added buckets"/><TextBlock Text="Search package names in your buckets…" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Grid.Column="1" Content="Search" Command="{Binding Commands[Search]}"/></Grid><DataGrid ItemsSource="{Binding Results}" SelectionChanged="SearchSelection" AutomationProperties.Name="Scoop search results"><DataGrid.Columns><DataGridTextColumn Header="App" Binding="{Binding Name}" Width="130"/><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90"/><DataGridTextColumn Header="Bucket" Binding="{Binding Bucket}" Width="90"/><DataGridTextColumn Header="Installed" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,0"><Button Content="Preview and install" Command="{Binding Commands[Install]}" Style="{StaticResource SmallAction}"/><Button Content="Info" Command="{Binding Commands[Info]}" Style="{StaticResource SmallAction}"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Buckets &amp; Cache"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DataGrid ItemsSource="{Binding Buckets}" SelectionChanged="BucketSelection" AutomationProperties.Name="Scoop buckets"><DataGrid.Columns><DataGridTextColumn Header="Bucket" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Manifests" Binding="{Binding Manifests}" Width="150"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,0"><Button Content="Refresh" Command="{Binding Commands[Refresh]}" Style="{StaticResource SmallAction}"/><Button Content="Remove selected" Command="{Binding Commands[RemoveBucket]}" Style="{StaticResource SmallAction}"/><Button Content="Update buckets" Command="{Binding Commands[UpdateBuckets]}" Style="{StaticResource SmallAction}"/><Button Content="Show cache" Command="{Binding Commands[ShowCache]}" Style="{StaticResource SmallAction}"/><Button Content="Clear cache" Command="{Binding Commands[ClearCache]}" Style="{StaticResource SmallAction}"/></WrapPanel><TextBlock Text="Add known bucket name, or supply an HTTPS repository URL." Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding BucketName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bucket name" Margin="0,0,8,0"/><TextBox Grid.Column="1" Text="{Binding BucketUrl,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Optional bucket repository URL" Margin="0,0,8,0"/><Button Grid.Column="2" Content="Add bucket" Command="{Binding Commands[AddBucket]}"/></Grid></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Custom App"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><ItemsControl ItemsSource="{Binding CustomFields}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="text" Grid.Column="1" Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"/><ComboBox x:Name="choice" Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" Visibility="Collapsed"/></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding Kind}" Value="Choice"><Setter TargetName="text" Property="Visibility" Value="Collapsed"/><Setter TargetName="choice" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel><Button Content="Browse folder…" Command="{Binding Commands[BrowseFolder]}" Style="{StaticResource SmallAction}"/><Button Content="Browse executable…" Command="{Binding Commands[BrowseExe]}" Style="{StaticResource SmallAction}"/><Button Content="Review and add to Scoop" Command="{Binding Commands[AddCustom]}" Style="{StaticResource SmallAction}"/></WrapPanel><TextBlock Text="Copy keeps the original folder. Move transfers it. Scoop reset recreates shims and shortcuts; Scoop uninstall removes the registered app." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,5" TextWrapping="Wrap"/>
  <TextBlock Grid.Row="4" Text="{Binding OperationStatus}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
  <ProgressBar Grid.Row="5" IsIndeterminate="True" Visibility="{Binding IsRunning,Converter={StaticResource ScoopVisible}}" Margin="0,0,0,12"/>
 </Grid>
</UserControl>
