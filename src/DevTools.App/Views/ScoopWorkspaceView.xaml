  <Style TargetType="DataGrid">
   <EventSetter Event="SizeChanged" Handler="GridResized"/>
   <Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="RowBackground" Value="{DynamicResource PanelBackground}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource SidebarBackground}"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Extended"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="MinHeight" Value="160"/><Setter Property="Height" Value="200"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SidebarBackground}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="10,11"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True" Margin="0,0,0,12"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="tab" Padding="13,10" Margin="0,0,7,0" CornerRadius="6" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="tab" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="FontSize" Value="11"/></Style>
 <DataTemplate x:Key="PackageEditor"><StackPanel Margin="0,12,0,0"><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><WrapPanel Margin="0,12,0,0"><Button Content="Full details / size" Command="{Binding Commands[Details]}" Style="{StaticResource SmallAction}"/><Button Content="Open folder" Command="{Binding Commands[OpenFolder]}" Style="{StaticResource SmallAction}"/><Button Content="Homepage" Command="{Binding Commands[Homepage]}" Style="{StaticResource SmallAction}"/></WrapPanel></StackPanel></DataTemplate><DataTemplate x:Key="VersionEditor"><StackPanel Margin="0,12,0,0"><TextBlock Text="Choose an installed version to activate." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/><ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Installed version" Margin="0,0,0,10"/><Button Content="Switch version" Command="{Binding Commands[SwitchVersion]}" HorizontalAlignment="Left" Style="{StaticResource SmallAction}"/></StackPanel></DataTemplate><DataTemplate x:Key="PathEditor"><StackPanel Margin="0,4,0,0">
  <TextBlock Text="Folders in PATH" FontSize="16" FontWeight="SemiBold"/>
  <TextBlock Text="Add folders for this app. Select a folder to edit or remove it, then save your changes." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10"/>
  <ListBox ItemsSource="{Binding PathItems}" SelectedItem="{Binding SelectedPath}" Height="170" AutomationProperties.Name="PATH folders" Margin="0,0,0,10" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="Transparent" Padding="10,7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
  </ListBox>
  <TextBlock Text="Folder path" Margin="0,0,0,5"/>
  <TextBox Text="{Binding PathDraft,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Folder path" Margin="0,0,0,8"/>
  <WrapPanel><Button Content="Add" Command="{Binding Commands[AddPathEntry]}" Style="{StaticResource SmallAction}"/><Button Content="Update selected" Command="{Binding Commands[ReplacePathEntry]}" Style="{StaticResource SmallAction}"/><Button Content="Remove selected" Command="{Binding Commands[RemovePathEntry]}" Style="{StaticResource SmallAction}"/><Button Content="Browse folder…" Command="{Binding Commands[AddPathFolder]}" Style="{StaticResource SmallAction}"/></WrapPanel>
  <TextBlock Text="{Binding PathMessage}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
  <TextBlock Text="Folders inside the app can be relative to its current version. Other folders use an absolute path." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
  <Button Content="Save rules" Command="{Binding Commands[SavePaths]}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
 </StackPanel></DataTemplate><Style x:Key="ManifestList" TargetType="ListBox"><Setter Property="Height" Value="90"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="Transparent" Padding="8,5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter></Style><DataTemplate x:Key="ManifestFields"><StackPanel>     <TextBlock Text="App name" Margin="0,0,0,5"/><TextBox Text="{Binding AuthorName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Manifest app name" Margin="0,0,0,10"/>
     <TextBlock Text="Version" Margin="0,0,0,5"/><TextBox Text="{Binding AuthorVersion,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Manifest version" Margin="0,0,0,10"/>
     <TextBlock Text="Direct download URL" Margin="0,0,0,5"/><TextBox Text="{Binding AuthorUrl,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="App download URL" Margin="0,0,0,10"/>
     <TextBlock Text="SHA-256 checksum" Margin="0,0,0,5"/><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Calculate…" Command="{Binding Commands[CalculateAuthorHash]}" Margin="8,0,0,0"/><TextBox Text="{Binding AuthorHash,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SHA-256 checksum"/></DockPanel>
     <TextBlock Text="Compare the checksum with the publisher’s value when available." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <TextBlock Text="Architecture" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding AuthorArchitectures}" SelectedItem="{Binding AuthorArchitecture}" AutomationProperties.Name="Package architecture" Margin="0,0,0,10"/>
     <TextBlock Text="Description" Margin="0,0,0,5"/><TextBox Text="{Binding AuthorDescription,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Manifest description" Margin="0,0,0,10"/>
     <TextBlock Text="Homepage (optional)" Margin="0,0,0,5"/><TextBox Text="{Binding AuthorHomepage,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Manifest homepage" Margin="0,0,0,10"/>
     <TextBlock Text="License (optional)" Margin="0,0,0,5"/><TextBox Text="{Binding AuthorLicense,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Manifest license" Margin="0,0,0,10"/>
     <TextBlock Text="Commands (optional)" FontWeight="SemiBold" Margin="0,4,0,5"/>
     <TextBlock Text="Add executable paths to make them available as commands in a terminal. Use paths inside the downloaded app, such as bin/tool.exe." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,7"/>
     <ListBox ItemsSource="{Binding AuthorExecutableItems}" SelectedItem="{Binding SelectedAuthorExecutable}" Style="{StaticResource ManifestList}" AutomationProperties.Name="Executable commands"/>
     <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Add" Command="{Binding Commands[AddAuthorExecutable]}" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="Remove selected" Command="{Binding Commands[RemoveAuthorExecutable]}" Margin="8,0,0,0"/><TextBox Text="{Binding AuthorExecutableDraft,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Executable path to add" ToolTip="Example: bin/tool.exe"/></DockPanel>
     <TextBlock Text="Start Menu shortcuts (optional)" FontWeight="SemiBold" Margin="0,0,0,5"/>
     <TextBlock Text="For each shortcut, enter the executable path inside the app and the name to show in the Start Menu." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,7"/>
     <ListBox ItemsSource="{Binding AuthorShortcutItems}" SelectedItem="{Binding SelectedAuthorShortcut}" Style="{StaticResource ManifestList}" AutomationProperties.Name="Start Menu shortcuts"/>
     <TextBlock Text="Executable path" Margin="0,0,0,4"/><TextBox Text="{Binding AuthorShortcutExecutableDraft,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Shortcut executable path" ToolTip="Example: app.exe" Margin="0,0,0,7"/>
     <TextBlock Text="Shortcut name" Margin="0,0,0,4"/><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Add" Command="{Binding Commands[AddAuthorShortcut]}" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="Remove selected" Command="{Binding Commands[RemoveAuthorShortcut]}" Margin="8,0,0,0"/><TextBox Text="{Binding AuthorShortcutNameDraft,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Shortcut display name" ToolTip="Example: My App"/></DockPanel>
     <TextBlock Text="PATH folders (optional)" FontWeight="SemiBold" Margin="0,0,0,5"/>
     <TextBlock Text="Add folders inside the app to PATH so their commands can be found. For example, add bin for the app’s bin folder." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,7"/>
     <ListBox ItemsSource="{Binding AuthorPathItems}" SelectedItem="{Binding SelectedAuthorPath}" Style="{StaticResource ManifestList}" AutomationProperties.Name="Manifest PATH folders"/>
     <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Add" Command="{Binding Commands[AddAuthorPath]}" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="Remove selected" Command="{Binding Commands[RemoveAuthorPath]}" Margin="8,0,0,0"/><TextBox Text="{Binding AuthorPathDraft,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PATH folder to add" ToolTip="Example: bin"/></DockPanel>
     <TextBlock Text="{Binding AuthorListMessage}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
</StackPanel></DataTemplate></UserControl.Resources>
 <Grid DataContext="{Binding ScoopWorkspace}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TabControl Grid.Row="2" SelectedIndex="{Binding Tab}">
   <TabItem Header="Installed packages"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Margin="0,0,10,0"><TextBox x:Name="FilterBox" Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter apps by name, bucket, held or update" ToolTip="Filter by name, version, bucket, held or update"/><TextBlock Text="Filter apps: name, bucket, held, update…" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Refresh" Command="{Binding Commands[Refresh]}" Margin="0,0,8,0"/>
<Button Content="Maintenance ▾" Click="OpenActionMenu" AutomationProperties.Name="Scoop maintenance">
 <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
  <MenuItem Header="Update Scoop and buckets" Command="{Binding Commands[UpdateBuckets]}"/>
  <MenuItem Header="Clean old versions…" Command="{Binding Commands[Cleanup]}"/>
  <Separator/>
  <MenuItem Header="View download cache" Command="{Binding Commands[ShowCache]}"/>
  <MenuItem Header="Clear download cache…" Command="{Binding Commands[ClearCache]}"/>
  <Separator/>
  <MenuItem Header="Reset all apps…" Command="{Binding Commands[ResetAll]}"/>
  <MenuItem Header="Reapply saved PATH rules…" Command="{Binding Commands[SyncPaths]}"/>
  <MenuItem Header="Import legacy PATH rules…" Command="{Binding Commands[ImportRules]}"/>
 </ContextMenu></Button.ContextMenu>
</Button></StackPanel></Grid>
    <StackPanel Grid.Row="1" Margin="0,0,0,4">
     <TextBlock Text="Selected apps" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,7"/>
     <Grid IsEnabled="{Binding HasSelection}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
       <Button Content="Package details…" Click="OpenDetails" Style="{StaticResource SmallAction}"/>
       <Button Content="Open homepage" Command="{Binding Commands[Homepage]}" Style="{StaticResource SmallAction}"/>
       <Button Content="Open app folder" Command="{Binding Commands[OpenFolder]}" Style="{StaticResource SmallAction}"/>
      </WrapPanel>
      <WrapPanel>
       <Button x:Name="UpdateButton" Content="Update" IsEnabled="False" Command="{Binding Commands[update]}" Style="{StaticResource SmallAction}"/>
       <Button Content="Uninstall…" Command="{Binding Commands[uninstall]}" Style="{StaticResource SmallAction}"/>
       <Button Content="Reset" Command="{Binding Commands[reset]}" Style="{StaticResource SmallAction}" ToolTip="Recreate shortcuts, shims and PATH for the selected apps"/>
       <Button x:Name="HoldButton" Content="Hold" Click="HoldToggle" Style="{StaticResource SmallAction}" ToolTip="Hold updates, or allow updates when all selected packages are held"/>
       <Button Content="Add / edit PATH…" Click="OpenPaths" Style="{StaticResource SmallAction}"/>
       <Button Content="Switch version…" Click="OpenVersions" Style="{StaticResource SmallAction}"/>
      </WrapPanel>
     </Grid>
    </StackPanel><DataGrid Grid.Row="2" x:Name="InstalledGrid" Height="Auto" MinHeight="100" ItemsSource="{Binding Installed}" SelectedItem="{Binding Selected}" SelectionChanged="InstalledSelection" PreviewMouseRightButtonDown="InstalledRightClick" MouseDoubleClick="DetailsClick" AutomationProperties.Name="Installed Scoop packages">
     <DataGrid.ContextMenu><ContextMenu Opened="ContextOpened"><MenuItem x:Name="ContextUpdateItem" Header="Update" Click="ContextUpdate"/><MenuItem Header="Reset" Click="ContextReset"/><MenuItem x:Name="ContextHold" Header="Hold" Click="HoldToggle"/><MenuItem Header="Uninstall…" Click="ContextUninstall"/><Separator/><MenuItem Header="Add / edit PATH…" Click="OpenPaths"/><MenuItem Header="Open app folder" Click="ContextFolder"/><MenuItem Header="Details and versions" Click="ContextDetails"/><MenuItem Header="Copy name" Click="CopyName"/></ContextMenu></DataGrid.ContextMenu>
     <DataGrid.Columns><DataGridTemplateColumn Header="App" SortMemberPath="Name" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image local:ScoopAsyncIcon.Directory="{Binding Directory}" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*"/><DataGridTextColumn Header="Bucket" Binding="{Binding Bucket}" Width="*"/><DataGridTextColumn Header="Held" Binding="{Binding HeldLabel}" Width="0.6*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.6*"/></DataGrid.Columns>
    </DataGrid>
    
    
    
   </Grid></TabItem>
   <TabItem Header="Updates"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Refresh list" Command="{Binding Commands[Refresh]}"/><Button DockPanel.Dock="Right" Content="Update Scoop and buckets" Command="{Binding Commands[UpdateBuckets]}" Margin="0,0,8,0" ToolTip="Update Scoop and its buckets, then refresh available package versions"/><StackPanel><TextBlock Text="Package updates" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Update Scoop and buckets to check for the latest available versions, then select packages to update." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DockPanel>
    <TextBlock Grid.Row="1" Text="{Binding UpdateCenterMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <DataGrid Grid.Row="2" Height="Auto" MinHeight="180" ItemsSource="{Binding UpdatePackages}" SelectionChanged="UpdateCenterSelection" AutomationProperties.Name="Available package updates"><DataGrid.Columns><DataGridTextColumn Header="Package" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Installed" Binding="{Binding Version}" Width="*"/><DataGridTextColumn Header="Available" Binding="{Binding AvailableVersion}" Width="*"/><DataGridTextColumn Header="Bucket" Binding="{Binding Bucket}" Width="*"/><DataGridTextColumn Header="Held" Binding="{Binding HeldLabel}" Width="*"/></DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="UpdateCenterButton" Content="Update selected…" Command="{Binding Commands[UpdateSelectedPackages]}" IsEnabled="False" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/><Button Content="Update all" Command="{Binding Commands[UpdateAll]}" ToolTip="Run Scoop update for all installed packages" Margin="0,0,10,0"/><TextBlock Text="Held packages must be unheld before updating." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
   </Grid></TabItem>
   <TabItem Header="Search"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Margin="0,0,10,0"><TextBox x:Name="SearchBox" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchKey" AutomationProperties.Name="Search package names in added buckets"/><TextBlock Text="Search package names in your buckets…" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Grid.Column="1" Content="Search" Command="{Binding Commands[Search]}"/></Grid><DataGrid x:Name="SearchGrid" ItemsSource="{Binding Results}" SelectionChanged="SearchSelection" PreviewMouseRightButtonDown="SearchRightClick" AutomationProperties.Name="Scoop search results"><DataGrid.ContextMenu><ContextMenu Opened="SearchContextOpened"><MenuItem x:Name="SearchDownloadMenu" Header="Download" Click="SearchDownload"/><MenuItem x:Name="SearchInfoMenu" Header="Info" Click="SearchInfo"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="App" Binding="{Binding Name}" Width="130"/><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90"/><DataGridTextColumn Header="Bucket" Binding="{Binding Bucket}" Width="90"/><DataGridTextColumn Header="Installed" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12,0,0"><Button x:Name="SearchDownloadButton" Content="Download" Command="{Binding Commands[Download]}" IsEnabled="False" ToolTip="Download to the Scoop cache without installing" Style="{StaticResource SmallAction}"/><Button x:Name="SearchInfoButton" Content="Info" Command="{Binding Commands[Info]}" IsEnabled="False" Style="{StaticResource SmallAction}"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Buckets &amp; Cache"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Buckets" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="Buckets are repositories of package manifests. Add one to make its packages available in Search." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,14"/>
    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="Your buckets" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock Text="Select one or more buckets to remove. Removing a bucket does not uninstall its packages." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
     <DataGrid ItemsSource="{Binding Buckets}" SelectionChanged="BucketSelection" AutomationProperties.Name="Scoop buckets" Height="180" Margin="0,0,0,10"><DataGrid.Columns><DataGridTextColumn Header="Bucket" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Packages" Binding="{Binding Manifests}" Width="150"/></DataGrid.Columns></DataGrid>
     <WrapPanel><Button Content="Refresh list" Command="{Binding Commands[Refresh]}" Style="{StaticResource SmallAction}"/><Button Content="Update buckets" Command="{Binding Commands[UpdateBuckets]}" Style="{StaticResource SmallAction}"/><Button x:Name="RemoveBucketButton" Content="Remove selected…" Command="{Binding Commands[RemoveBucket]}" IsEnabled="False" Style="{StaticResource SmallAction}"/></WrapPanel>
    </StackPanel></Border>
    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="Add a bucket" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock Text="Enter a known bucket name, such as extras. For another repository, enter a name and its HTTPS URL." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
     <TextBlock Text="Bucket name" Margin="0,0,0,5"/><TextBox Text="{Binding BucketName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bucket name" Margin="0,0,0,10"/>
     <TextBlock Text="Repository URL (optional for known buckets)" Margin="0,0,0,5"/><TextBox Text="{Binding BucketUrl,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Optional bucket repository URL" Margin="0,0,0,10"/>
     <Button Content="Add bucket…" Command="{Binding Commands[AddBucket]}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
    </StackPanel></Border>
    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel>
     <TextBlock Text="Download cache" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Scoop keeps downloaded files here. Clearing the cache does not uninstall packages." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
     <WrapPanel><Button Content="View cache" Command="{Binding Commands[ShowCache]}" Style="{StaticResource SmallAction}"/><Button Content="Clear cache…" Command="{Binding Commands[ClearCache]}" Style="{StaticResource SmallAction}"/></WrapPanel>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Custom App"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Add a portable app" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="Register an existing portable app with Scoop so you can manage it alongside your other packages." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,14"/>
    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="1. Choose the app" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock Text="Choose the folder containing the app, then choose its main executable inside that folder." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
     <TextBlock Text="App folder" Margin="0,0,0,5"/><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding Commands[BrowseFolder]}" Margin="8,0,0,0"/><TextBox Text="{Binding CustomFields[2].Value,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="App folder"/></DockPanel>
     <TextBlock Text="Main executable" Margin="0,0,0,5"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding Commands[BrowseExe]}" Margin="8,0,0,0"/><TextBox Text="{Binding CustomFields[3].Value,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Main executable"/></DockPanel>
    </StackPanel></Border>
    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="2. App details" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="The app name identifies it in Scoop. You can change the suggested details before adding it." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
     <TextBlock Text="App name" Margin="0,0,0,5"/><TextBox Text="{Binding CustomFields[0].Value,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="App name" Margin="0,0,0,10"/>
     <TextBlock Text="Version" Margin="0,0,0,5"/><TextBox Text="{Binding CustomFields[1].Value,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Version" Margin="0,0,0,10"/>
     <TextBlock Text="Start Menu shortcut name" Margin="0,0,0,5"/><TextBox Text="{Binding CustomFields[4].Value,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Shortcut name" Margin="0,0,0,10"/>
     <TextBlock Text="Command name (optional)" Margin="0,0,0,5"/><TextBox Text="{Binding CustomFields[5].Value,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Shim name (optional)" Margin="0,0,0,10"/>
     <TextBlock Text="Description (optional)" Margin="0,0,0,5"/><TextBox Text="{Binding CustomFields[6].Value,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description"/>
    </StackPanel></Border>
    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel>
     <TextBlock Text="3. Choose how to add it" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Copy keeps the original folder. Move transfers it into Scoop. You can review the source and destination before continuing." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
     <ComboBox ItemsSource="{Binding CustomFields[7].Choices}" SelectedItem="{Binding CustomFields[7].Value}" AutomationProperties.Name="Add method" Width="150" HorizontalAlignment="Left" Margin="0,0,0,12"/>
     <Button Content="Review and add to Scoop…" Command="{Binding Commands[AddCustom]}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Setup"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel Margin="0,0,0,14"><TextBlock Text="Scoop manager" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,18,0"/><Button Content="Locate Scoop…" Command="{Binding Commands[ChooseRoot]}" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox IsReadOnly="True" Text="{Binding Root,UpdateSourceTrigger=PropertyChanged}" ToolTip="Scoop root folder" AutomationProperties.Name="Scoop root folder"/></DockPanel>
  <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"><DockPanel><Button DockPanel.Dock="Right" Content="Check again" Command="{Binding Commands[CheckSetup]}" Margin="8,0,0,0" IsEnabled="{Binding IsRunning,Converter={StaticResource EnabledSetup}}"/><Button DockPanel.Dock="Right" Content="Add to PATH" Command="{Binding Commands[AddScoopPath]}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Visibility="{Binding NeedsPath,Converter={StaticResource ScoopVisible}}" IsEnabled="{Binding IsRunning,Converter={StaticResource EnabledSetup}}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SetupTitle}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding SetupMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
<Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="Set up this PC" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Configure the selected portable Scoop installation for this Windows user. This sets SCOOP and adds its shims to your user PATH." TextWrapping="Wrap" Margin="0,8,0,10"/><Button Content="Set up this PC…" Command="{Binding Commands[PortableSetup]}" HorizontalAlignment="Left" IsEnabled="{Binding IsRunning,Converter={StaticResource EnabledSetup}}"/></StackPanel></Border><Border Visibility="{Binding ShowInstall,Converter={StaticResource ScoopVisible}}"><Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="24" VerticalAlignment="Top"><StackPanel IsEnabled="{Binding IsRunning,Converter={StaticResource EnabledSetup}}"><TextBlock Text="Install Scoop" FontSize="21"/><TextBlock Text="Manage packages with Scoop, or locate an installation you already have." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,22"/><TextBlock Text="Install location" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding Commands[BrowseInstallLocation]}" Margin="10,0,0,0"/><TextBox Text="{Binding InstallLocation,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Scoop install location"/></DockPanel><WrapPanel Margin="0,22,0,0"><Button Content="Install Scoop" Command="{Binding Commands[InstallScoop]}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/><Button Content="Locate existing installation" Command="{Binding Commands[ChooseRoot]}" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="Progress appears in Activity. Existing PATH entries are preserved." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Manifest manager"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Manifest manager" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Create a bucket, make a new app manifest, or edit one in an existing bucket." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    <TabControl><TabItem Header="Create bucket"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="Create a local bucket" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Buckets are created in the current Scoop installation’s buckets folder. They are local and have no Git remote until you configure one; they cannot be published or pulled automatically. You can add apps to a bucket from the Create manifest section." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
     <TextBlock Text="Bucket name" Margin="0,0,0,5"/><TextBox Text="{Binding NewBucketName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New bucket name" Margin="0,0,0,10"/>
     <Button Content="Create bucket…" Command="{Binding Commands[CreateLocalBucket]}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
    </StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Create manifest"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="Create a manifest" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Use a direct HTTPS download from the official website or a GitHub release asset. Review the app details and checksum before saving." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
     <TextBlock Text="From GitHub (optional)" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock Text="Enter a repository URL, load its releases, then select a Windows asset. For an official website, skip this step and enter its direct download URL below." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Load releases" Command="{Binding Commands[LoadGitHubReleases]}" Margin="8,0,0,0"/><TextBox Text="{Binding GitHubRepository,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="GitHub repository URL"/></DockPanel>
     <TextBlock Text="Release" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding GitHubReleaseNames}" SelectedItem="{Binding SelectedGitHubRelease}" AutomationProperties.Name="GitHub release" Margin="0,0,0,8"/>
     <TextBlock Text="Release asset" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding GitHubAssetNames}" SelectedItem="{Binding SelectedGitHubAsset}" AutomationProperties.Name="GitHub release asset" Margin="0,0,0,12"/>
     <TextBlock Text="Destination bucket (for saving to a bucket)" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding AuthorBuckets}" SelectedItem="{Binding AuthorBucket}" AutomationProperties.Name="Destination bucket" Margin="0,0,0,10"/>
     <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ManifestFields}"/>
     <TextBlock Text="Some installers require additional manifest configuration. Review the generated manifest before using it." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
     <TextBlock Text="Check the manifest and preview its JSON before saving. This check does not install or download the app." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/><WrapPanel><Button Content="Check and preview…" Command="{Binding Commands[PreviewNewManifest]}" Style="{StaticResource SmallAction}"/><Button Content="Review and save to bucket…" Command="{Binding Commands[SaveBucketManifest]}" Style="{StaticResource SmallAction}"/><Button Content="Export JSON…" Command="{Binding Commands[ExportManifestJson]}" Style="{StaticResource SmallAction}"/></WrapPanel>
     <TextBlock Text="Export saves a JSON file in a folder you choose, so you can add it to a bucket yourself." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Edit manifest"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="Edit an existing manifest" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock Text="Choose a bucket and app, then open its manifest. Its values appear below. Edit the fields, apply them to the JSON, then review and save. Advanced fields remain in the JSON." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
     <TextBlock Text="Bucket" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding AuthorBuckets}" SelectedItem="{Binding EditorBucket}" AutomationProperties.Name="Bucket to edit" Margin="0,0,0,10"/>
     <TextBlock Text="App manifest" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding EditorManifestNames}" SelectedItem="{Binding EditorManifest}" AutomationProperties.Name="App manifest to edit" Margin="0,0,0,10"/>
     <WrapPanel><Button Content="Open selected manifest" Command="{Binding Commands[LoadSelectedBucketJson]}" Style="{StaticResource SmallAction}"/><Button Content="Browse for JSON…" Command="{Binding Commands[LoadBucketJson]}" Style="{StaticResource SmallAction}"/></WrapPanel>
     <TextBlock Text="{Binding ManifestEditorFile}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ManifestFields}"/>
     <Button Content="Check and preview…" Command="{Binding Commands[InspectEditedManifest]}" HorizontalAlignment="Left" Style="{StaticResource SmallAction}"/>
     <Button Content="Apply form changes to JSON" Command="{Binding Commands[ApplyManifestForm]}" HorizontalAlignment="Left" Style="{StaticResource SmallAction}"/>
     <TextBlock Text="Advanced JSON" FontWeight="SemiBold" Margin="0,6,0,5"/>
     <TextBox Text="{Binding ManifestJson,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Manifest JSON editor" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" Height="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,0,0,10"/>
     <Button Content="Review and save changes…" Command="{Binding Commands[SaveBucketJson]}" HorizontalAlignment="Left" Style="{StaticResource SmallAction}"/>
    </StackPanel></Border>
</StackPanel></ScrollViewer></TabItem></TabControl>
   </DockPanel></TabItem>

  </TabControl>
  <TextBlock Grid.Row="3" Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,5" TextWrapping="Wrap"/>
  <TextBlock Grid.Row="4" Text="{Binding OperationStatus}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
  <ProgressBar Grid.Row="5" IsIndeterminate="True" Visibility="{Binding IsRunning,Converter={StaticResource ScoopVisible}}" Margin="0,0,0,12"/>
 </Grid>
</UserControl>
