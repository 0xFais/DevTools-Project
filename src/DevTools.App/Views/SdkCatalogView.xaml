<UserControl x:Class="DevTools.App.Views.SdkCatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:DevTools.App">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/><app:InverseBooleanConverter x:Key="Enabled"/></UserControl.Resources>
 <Grid DataContext="{Binding SdkCatalogWorkspace}" IsEnabled="{Binding DataContext.IsBusy,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource Enabled}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,15"><TextBlock Text="SDKs &amp; Runtimes" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Installed versions found across your development toolchains." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding Commands[Refresh]}" Margin="10,0,0,0"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
  <Border Grid.Row="2" CornerRadius="9" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource PanelBackground}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.7*" MinWidth="210"/><ColumnDefinition Width="1.8*" MinWidth="390"/></Grid.ColumnDefinitions>
   <ListBox ItemsSource="{Binding Ecosystems}" SelectedItem="{Binding SelectedEcosystem,Mode=TwoWay}" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Detected SDK ecosystems"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="Transparent" Padding="14,11" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DisplayVersion}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Border Grid.Column="1" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid>
    <StackPanel Visibility="{Binding IsDotNetSelected,Converter={StaticResource Visible}}"><TextBlock Text="SCOOP PACKAGE · DOTNET-SDK" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text=".NET SDK" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,10"/><Border Background="{DynamicResource SelectionBrush}" CornerRadius="5" Padding="8,6" Margin="0,0,0,12"><TextBlock Text="{Binding HostSummary}" FontSize="10" TextWrapping="Wrap"/></Border>
     <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,10"><StackPanel><Grid><TextBlock Text="Installed SDKs" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding DotnetSdks.Count,StringFormat={}{0} versions}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></Grid><TextBox Text="{Binding SdkDetails}" IsReadOnly="True" IsTabStop="False" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0" FontSize="10" Foreground="{DynamicResource MutedBrush}" MinHeight="34" MaxHeight="54" Margin="0,7,0,0"/></StackPanel></Border>
     <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,10"><StackPanel><Grid><TextBlock Text="Installed runtimes" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding DotnetRuntimes.Count,StringFormat={}{0} runtimes}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></Grid><TextBox Text="{Binding RuntimeDetails}" IsReadOnly="True" IsTabStop="False" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0" FontSize="10" Foreground="{DynamicResource MutedBrush}" MinHeight="96" MaxHeight="118" Margin="0,7,0,0"/></StackPanel></Border>
     <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="11"><StackPanel><TextBlock Text="HOST DETAILS" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="Base path" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,2"/><TextBlock Text="{Binding BasePath}" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="dotnet.exe" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,2"/><TextBlock Text="{Binding DotnetPath}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
    </StackPanel>
    <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDotNetSelected}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding SelectedEcosystem.Name}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedEcosystem.Description}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,14" TextWrapping="Wrap"/><TextBlock Text="Installed version" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding SelectedEcosystem.Version}" FontSize="15" Margin="0,4,0,12" TextWrapping="Wrap"/><TextBlock Text="Resolved command" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding SelectedEcosystem.Location}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
   </Grid></ScrollViewer></Border>
  </Grid></Border>
 </Grid>
</UserControl>
