<UserControl x:Class="DevTools.App.Views.BinaryInventoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:DevTools.App">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/><app:InverseBooleanConverter x:Key="Enabled"/></UserControl.Resources>
 <Grid DataContext="{Binding BinaryInventoryWorkspace}" IsEnabled="{Binding DataContext.IsBusy,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource Enabled}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="Developer binaries" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Scoop installed developer tools, their versions, and package locations." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding Commands[Scan]}" Margin="10,0,0,0"/><Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search installed packages"/><TextBlock Text="Search installed packages…" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
  <Border Grid.Row="2" CornerRadius="9" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource PanelBackground}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
   <DockPanel><Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,9"><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></Border>
    <ListBox ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding Selected,Mode=TwoWay}" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Scoop installed developer binaries"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="Transparent" Padding="15,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="13"/><TextBlock Text="{Binding Executable}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DisplayStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
   <Border Grid.Column="1" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="19"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="SCOOP PACKAGE" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding Selected.Name,FallbackValue=Select a package}" FontSize="21" TextWrapping="Wrap" Margin="0,8,0,6"/><TextBlock Text="{Binding Selected.Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"/><StackPanel Visibility="{Binding HasSelection,Converter={StaticResource Visible}}"><TextBlock Text="Status" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Selected.DisplayStatus}" Margin="0,4,0,12"/><TextBlock Text="Package version" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Selected.Version,FallbackValue=Not available}" Margin="0,4,0,12"/><TextBlock Text="Command path" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBox Text="{Binding Selected.Path,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,0,14"/><TextBlock Text="Package details" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBox Text="{Binding Selected.Details,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" MaxHeight="260" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,0,14"/><TextBlock Text="{Binding ScoopMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/></StackPanel></StackPanel></ScrollViewer></Border>
  </Grid></Border>
 </Grid>
</UserControl>
