<UserControl x:Class="DevTools.App.Views.FolderInspectorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:DevTools.App" xmlns:local="clr-namespace:DevTools.App.Views">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/><app:InverseBooleanConverter x:Key="Enabled"/><local:FolderSelectedConverter x:Key="FolderSelected"/>
  <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,7,8"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="11"/></Style>
 </UserControl.Resources>
 <Grid DataContext="{Binding FolderWorkspace}" IsEnabled="{Binding DataContext.IsBusy,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource Enabled}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="User folders" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Manage Windows folder locations and your own folders." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Refresh" Command="{Binding Commands[Refresh]}" Margin="10,0,8,0"/><Button Content="Add custom folder" Command="{Binding Commands[AddCustom]}"/></StackPanel><Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search folders" ToolTip="Search folder names, paths or types"/><TextBlock Text="Find a folder by name or location…" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
  <Border Grid.Row="2" CornerRadius="9" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource PanelBackground}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="210"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected,Mode=TwoWay}" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Windows and custom folders">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="Transparent" Padding="15,13" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Symbol}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="13"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Column="1" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="19"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding InspectorTitle}" FontSize="21" TextWrapping="Wrap" Margin="0,8,0,15"/>
     <StackPanel Visibility="{Binding IsCustomEditor,Converter={StaticResource Visible}}"><TextBlock Text="Folder name" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/><TextBox Text="{Binding CustomName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom folder name"/><TextBlock Text="Source folder" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,7"/><TextBox Text="{Binding CustomSource,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom source folder"/><WrapPanel Margin="0,12,0,0"><Button Content="Browse…" Command="{Binding Commands[BrowseSource]}" Style="{StaticResource Action}"/><Button Content="Save custom folder" Command="{Binding Commands[SaveCustom]}" Style="{StaticResource Action}"/></WrapPanel></StackPanel>
     <StackPanel Visibility="{Binding Selected,Converter={StaticResource FolderSelected}}">
      <TextBlock Text="Current location" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/><TextBox Text="{Binding CurrentPath,Mode=OneWay}" ToolTip="{Binding CurrentPath}" MaxHeight="76" VerticalScrollBarVisibility="Auto" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" BorderThickness="0" Padding="0" Background="Transparent"/>
      <StackPanel IsEnabled="{Binding CanChange}"><TextBlock Text="New location" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,17,0,7"/><TextBox Text="{Binding Target,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New folder location"/><Button Content="Browse destination…" Command="{Binding Commands[BrowseTarget]}" HorizontalAlignment="Left" Margin="0,8,0,12" Padding="10,8" FontSize="11"/>
       <CheckBox IsChecked="{Binding MoveFiles}" Visibility="{Binding IsWindowsFolder,Converter={StaticResource Visible}}" Margin="0,0,0,12"><TextBlock Text="Move existing files too" TextWrapping="Wrap"/></CheckBox>
       <Button Content="Review change" Command="{Binding Commands[Review]}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
      </StackPanel>
      <WrapPanel><Button Content="Open folder" Command="{Binding Commands[Open]}" Style="{StaticResource Action}"/><Button Content="Restore default" Command="{Binding Commands[Default]}" Style="{StaticResource Action}" Visibility="{Binding IsWindowsFolder,Converter={StaticResource Visible}}" IsEnabled="{Binding CanChange}"/><Button Content="Remove saved folder" Command="{Binding Commands[RemoveCustom]}" Style="{StaticResource Action}" Visibility="{Binding IsCustomFolder,Converter={StaticResource Visible}}"/></WrapPanel>
     </StackPanel>
     <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,8"/>
    </StackPanel></ScrollViewer></Border>
   </Grid>
  </Border>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Change journals" Command="{Binding Commands[Journals]}" Padding="10,7" FontSize="11"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</UserControl>
