<UserControl x:Class="DevTools.App.Views.IntegrationBrowserView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DevTools.App" HorizontalContentAlignment="Stretch">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/><local:InverseBooleanConverter x:Key="Enabled"/>
    <DataTemplate x:Key="ToolbarAction"><Button Content="{Binding Title}" Command="{Binding}" Margin="8,0,0,0" Padding="11,9" Height="38" FontSize="11" Visibility="{Binding IsVisible,Converter={StaticResource Visible}}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate>
    <DataTemplate x:Key="Action"><Button Content="{Binding Title}" Command="{Binding}" Margin="0,0,7,8" Padding="11,9" FontSize="11" Visibility="{Binding IsVisible,Converter={StaticResource Visible}}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate>
    <DataTemplate x:Key="Field"><StackPanel x:Name="fieldPanel" Margin="0,0,0,13"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Grid x:Name="labelRow" Margin="0,0,0,7"><TextBlock x:Name="label" Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,0" VerticalAlignment="Center"/><Button x:Name="browse" Visibility="Collapsed" Content="Browse…" Padding="6,2" FontSize="10" HorizontalAlignment="Right" Command="{Binding DataContext.Browser.BrowseAction,RelativeSource={RelativeSource AncestorType=UserControl}}"/></Grid><Grid><TextBox x:Name="text" IsReadOnly="{Binding IsReadOnly}" Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" TextWrapping="NoWrap" ToolTip="{Binding Value}" FontSize="11" Padding="9,9" MinHeight="36" AutomationProperties.Name="{Binding Label}"/><ComboBox x:Name="choice" Visibility="Collapsed" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" FontSize="11" AutomationProperties.Name="{Binding Label}"/><CheckBox x:Name="toggle" Visibility="Collapsed" IsChecked="{Binding IsChecked}" Content="{Binding Label}" FontSize="12" Padding="5,0" AutomationProperties.Name="{Binding Label}"/><TextBlock x:Name="readOnly" Visibility="Collapsed" Text="{Binding Value}" TextWrapping="Wrap" FontSize="11"/></Grid><TextBlock x:Name="hint" Text="{Binding Hint}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding Key}" Value="path"><Setter TargetName="browse" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Hint}" Value=""><Setter TargetName="hint" Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Toggle"><Setter TargetName="fieldPanel" Property="Margin" Value="0,0,0,8"/><Setter TargetName="labelRow" Property="Visibility" Value="Collapsed"/><Setter TargetName="text" Property="Visibility" Value="Collapsed"/><Setter TargetName="label" Property="Visibility" Value="Collapsed"/><Setter TargetName="toggle" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Choice"><Setter TargetName="text" Property="Visibility" Value="Collapsed"/><Setter TargetName="choice" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="ReadOnly"><Setter TargetName="text" Property="Visibility" Value="Collapsed"/><Setter TargetName="readOnly" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="✓  Already added · detected automatically" FontSize="11" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Height="38" Margin="0,0,8,0"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="33"/><ColumnDefinition Width="*"/><ColumnDefinition Width="31"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding Browser.SearchText,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0,10" FontSize="12" AutomationProperties.Name="{Binding Browser.SearchPlaceholder}" ToolTip="{Binding Browser.SearchPlaceholder}" KeyDown="SearchKeyDown"/>
        <TextBlock Grid.Column="1" Text="{Binding Browser.SearchPlaceholder}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Browser.SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Button Grid.Column="2" Content="×" Command="{Binding Browser.ClearSearchCommand}" Padding="0" Background="Transparent" BorderBrush="Transparent" Visibility="{Binding Browser.HasSearch,Converter={StaticResource Visible}}" AutomationProperties.Name="Clear search" ToolTip="Clear search"/>
      </Grid></Border>
      <ItemsControl Grid.Column="1" MinWidth="322" Height="38" ItemsSource="{Binding Browser.ToolbarActions}" ItemTemplate="{StaticResource ToolbarAction}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
    </Grid>
    <Border Style="{StaticResource Panel}" Padding="0"><Grid MinHeight="385"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="240"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="17,0,17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="APPLICATION" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="STATUS" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid><Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
        <ListBox x:Name="ApplicationList" Grid.Row="1" ItemsSource="{Binding Browser.Items}" SelectedItem="{Binding Browser.Selected,Mode=TwoWay}" MinHeight="340" MaxHeight="485" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Detected application registrations" IsEnabled="{Binding DataContext.IsBusy,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource Enabled}}"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="16,14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><Grid Margin="0,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="29" Height="31" HorizontalAlignment="Left" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="{Binding Symbol}" Foreground="{DynamicResource AccentBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Locations}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Grid><TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsAdded}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        <StackPanel Grid.Row="1" Margin="24,45" Visibility="{Binding Browser.IsEmpty,Converter={StaticResource Visible}}" IsHitTestVisible="False"><TextBlock Text="{Binding Browser.EmptyTitle}" FontSize="15" TextWrapping="Wrap"/><TextBlock Text="{Binding Browser.EmptyHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/></StackPanel>
      </Grid>
      <Border Grid.Column="1" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="20"><StackPanel><TextBlock Text="APPLICATION DETAILS" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,17"/><TextBlock Text="{Binding Browser.InspectorTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Browser.InspectorSubtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,18"/>
        <StackPanel Visibility="{Binding Browser.HasInspector,Converter={StaticResource Visible}}"><ItemsControl ItemsSource="{Binding Browser.InspectorFields}" ItemTemplate="{StaticResource Field}" IsEnabled="{Binding Browser.CanEdit}"/><TextBlock Text="{Binding Browser.Notice}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,17"/><ItemsControl ItemsSource="{Binding Browser.InspectorActions}" ItemTemplate="{StaticResource Action}" Visibility="{Binding Browser.CanEdit,Converter={StaticResource Visible}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
      </StackPanel></Border>
    </Grid></Border>
    <Grid Margin="1,13,1,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Browser.Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Browser.DiscoveryHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="12,0,0,0"/></Grid>
    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,15"/>
    <ItemsControl ItemsSource="{Binding Browser.ExtraFields}" ItemTemplate="{StaticResource Field}"/>
    <ItemsControl ItemsSource="{Binding Browser.ExtraActions}" ItemTemplate="{StaticResource Action}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
  </StackPanel>
</UserControl>



