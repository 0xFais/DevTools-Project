<UserControl x:Class="DevTools.App.Views.WindowsWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DevTools.App">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
  <StackPanel>
    <Border Style="{StaticResource Panel}" Padding="18"><StackPanel>
      <Grid Margin="0,0,0,14"><TextBlock Text="CURRENT WINDOWS STATUS" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><Button Content="Refresh ↻" Command="{Binding WindowsWorkspace.RefreshAction}" HorizontalAlignment="Right" Background="Transparent" FontSize="11" Padding="8,3"/></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock x:Name="StatusHeading" Text="{Binding WindowsWorkspace.Heading}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding WindowsWorkspace.Description}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Width="130" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" VerticalAlignment="Top" Padding="8,4"><TextBlock x:Name="StatusBadge" HorizontalAlignment="Center" Text="{Binding WindowsWorkspace.Badge}" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding WindowsWorkspace.IsPositive}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></Grid>
      <Grid x:Name="UpdateFacts" Margin="0,17,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Update service" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding WindowsWorkspace.ServiceState}" FontSize="11" TextWrapping="Wrap" Margin="0,4,10,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Settings pause date" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding WindowsWorkspace.Startup}" FontSize="11" Margin="0,4,10,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Update check" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding WindowsWorkspace.Health}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid>
      <WrapPanel x:Name="UpdateStatusActions"><Button Content="Restore previous settings" Command="{Binding WindowsWorkspace.ResumeAction}" Margin="0,0,8,0" FontSize="11" Padding="11,8"/><Button Content="Check update health" Command="{Binding WindowsWorkspace.HealthAction}" FontSize="11" Padding="11,8"/></WrapPanel>
      <StackPanel x:Name="ActivationStatusActions" Visibility="Collapsed" Margin="0,14,0,0"><TextBlock Text="{Binding WindowsWorkspace.License,StringFormat=License status: {0}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/><Button Content="Check license details" Command="{Binding WindowsWorkspace.DetailsAction}" HorizontalAlignment="Left" FontSize="11" Padding="11,8"/></StackPanel>
    </StackPanel></Border>
    <StackPanel x:Name="UpdateOptions" Margin="0,16,0,0">
      <Border Style="{StaticResource Panel}" Padding="18"><StackPanel>
        <TextBlock Text="Extend the Windows pause" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="Choose a date to display in Windows Update Settings." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,15"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
          <StackPanel><ComboBox x:Name="PolicyDuration" ItemsSource="{Binding [duration].Choices}" SelectedItem="{Binding [duration].Value}" AutomationProperties.Name="Pause duration"/>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding [restoreDate].IsVisible,Converter={StaticResource Visible}}"><TextBlock Text="Pause until (YYYY-MM-DD, local midnight)" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><TextBox x:Name="PolicyRestoreDate" Text="{Binding [restoreDate].Value,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom restore date"/></StackPanel>
          </StackPanel>
          <Button x:Name="PauseUpdatesButton" Grid.Column="2" Content="Apply pause" Command="{Binding WindowsWorkspace.PauseAction}" Style="{StaticResource PrimaryButton}" FontSize="12" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock Text="{Binding WindowsWorkspace.Resume}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"/>
      </StackPanel></Border>
      <TextBlock Text="Original pause settings restore at the selected deadline while signed in, or at the next sign-in. Windows pause requires an end date; custom dates support up to ten years." FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="4,12,4,0" TextWrapping="Wrap"/>
      <TextBlock Text="This is a registry workaround, not a guarantee across Windows builds. Reopen Windows Update to check the displayed date. Already queued updates may finish, and security updates will be paused." FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="4,8,4,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid x:Name="ActivationOptions" Margin="0,16,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}" Padding="18"><StackPanel><TextBlock Text="Matching public key" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding WindowsWorkspace.KeyNote}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,14"/><TextBox Text="{Binding WindowsWorkspace.PublicKey,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Padding="11" AutomationProperties.Name="Matching Microsoft public volume key"/><TextBlock Text="Microsoft generic volume key · GVLK" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,12"/><Button Content="Copy public key" IsEnabled="{Binding WindowsWorkspace.HasPublicKey}" Click="CopyKeyClick" HorizontalAlignment="Left" FontSize="11" Padding="11,8"/><TextBlock Text="For licensed organization activation. This key does not provide a Windows license." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,14"/>
        <CheckBox IsChecked="{Binding [custom].IsChecked}" Content="Use my own licensed product key" FontSize="11" Padding="5,3"/>
        <PasswordBox x:Name="CustomKeyBox" Margin="0,9,0,0" Visibility="{Binding [custom].IsChecked,Converter={StaticResource Visible}}" local:PasswordBinding.Value="{Binding [key].Value,Mode=TwoWay}" AutomationProperties.Name="Your licensed Windows product key"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="18"><StackPanel><TextBlock Text="Activate Windows" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Use your organization's licensed activation service, or your own licensed key." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,19"/><TextBlock Text="Organization KMS server" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding [server].Value,UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave blank for DNS auto-discovery. Custom retail keys do not require a KMS server." FontSize="12" AutomationProperties.Name="Organization KMS server"/><TextBlock Text="Leave blank for DNS auto-discovery." FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,17" TextWrapping="Wrap"/><Button x:Name="ActivateButton" Content="Install key &amp; activate" Command="{Binding WindowsWorkspace.ActivateAction}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" FontSize="12"/><TextBlock Text="A confirmation appears before the selected key is installed." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
    </Grid>
    <WrapPanel Margin="0,18,0,0"><Button Content="{Binding WindowsWorkspace.SettingsAction.Title}" Command="{Binding WindowsWorkspace.SettingsAction}" FontSize="11" Padding="11,8"/><Button x:Name="ServiceDetailsButton" Content="Service details" Command="{Binding WindowsWorkspace.DetailsAction}" FontSize="11" Padding="11,8" Margin="8,0,0,0"/></WrapPanel>
    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,13,0,0"/>
  </StackPanel>
</UserControl>

