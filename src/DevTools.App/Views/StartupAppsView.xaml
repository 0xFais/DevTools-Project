<UserControl x:Class="DevTools.App.Views.StartupAppsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DevTools.App" Loaded="LoadedView" DataContextChanged="ContextChanged">
 <UserControl.Resources><local:InverseBooleanConverter x:Key="NotBusy"/><BooleanToVisibilityConverter x:Key="VisibleIf"/></UserControl.Resources>
 <Grid DataContext="{Binding StartupAppsWorkspace}" IsEnabled="{Binding DataContext.IsBusy,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource NotBusy}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
   <TextBlock Text="WINDOWS TOOLS" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
   <TextBlock Text="{Binding DataContext.Title,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding DataContext.Description,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,14"/>
   <DockPanel Margin="0,0,0,12"><Button Content="Refresh" Command="{Binding RefreshAction}" DockPanel.Dock="Right" Padding="12,8" Margin="12,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Summary}" FontSize="12"/><TextBlock Text="Run registry entries and user/common Startup folders · scheduled tasks and services are not included" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DockPanel>
  </StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10">
   <Grid><TextBlock x:Name="EmptyStartupMessage" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Refresh to inspect this account's startup apps."/><Style.Triggers><DataTrigger Binding="{Binding IsInitialized}" Value="True"><Setter Property="Text" Value="No startup entries were found in the inspected sources. Check any read warnings below."/></DataTrigger><DataTrigger Binding="{Binding HasItems}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ScrollViewer VerticalScrollBarVisibility="Auto"><ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem,Mode=TwoWay}" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="selection" Background="{TemplateBinding Background}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="selection" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="selection" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="selection" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,8,0"/></StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Scope}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="3" Text="{Binding Command}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
     </Grid>
    </Border>
   </DataTemplate></ListBox.ItemTemplate><ListBox.Template><ControlTemplate TargetType="ListBox"><StackPanel><Grid Margin="14,10"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="APP / SOURCE" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="SCOPE" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="2" Text="STATUS" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="3" Text="COMMAND" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></Grid><ItemsPresenter/></StackPanel></ControlTemplate></ListBox.Template></ListBox></ScrollViewer></Grid>
  </Border>
  <StackPanel Grid.Row="2"><TextBlock Text="Add an app for your account" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Executable" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding SelectedExecutable,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" ToolTip="Choose an existing executable"/></StackPanel><Button Grid.Column="1" Content="Choose .exe" Command="{Binding BrowseAction}" Margin="8,14,0,0"/></Grid>
   <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Startup name" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding AppName,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Optional arguments" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding Arguments,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
   <WrapPanel Margin="0,7,0,0"><Button Content="Add to my startup" Command="{Binding AddAction}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="Remove from startup" Command="{Binding RemoveAction}" Margin="0,0,8,0"/><Button Content="Open Windows startup settings" Command="{Binding SettingsAction}"/></WrapPanel><TextBlock Text="Registry Run entries and regular files in the Startup folders can be removed. Startup files are moved into an archive, not deleted." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
   <TextBlock Text="{Binding Result}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>
  </StackPanel>
 </Grid>
</UserControl>
