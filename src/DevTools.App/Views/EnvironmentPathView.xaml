<UserControl x:Class="DevTools.App.Views.EnvironmentPathView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:DevTools.App">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/><app:InverseBooleanConverter x:Key="Enabled"/></UserControl.Resources>
 <Grid DataContext="{Binding EnvironmentPathWorkspace}" IsEnabled="{Binding DataContext.IsBusy,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource Enabled}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,15"><TextBlock Text="Environment &amp; PATH" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Inspect where developer commands are found and how PATH is assembled." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding Commands[Refresh]}" Margin="10,0,0,0"/><Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search environment variables"/><TextBlock Text="Search environment variables…" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
  <Border Grid.Row="2" CornerRadius="9" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource PanelBackground}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="250"/><ColumnDefinition Width="1.15*" MinWidth="350"/></Grid.ColumnDefinitions>
   <DockPanel><Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,9"><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/></Border>
    <ListBox ItemsSource="{Binding VisibleVariables}" SelectedItem="{Binding SelectedVariable,Mode=TwoWay}" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Environment variables"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="Transparent" Padding="13,9" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Source}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="150" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayValue}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
   <Border Grid.Column="1" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="SELECTED VARIABLE" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding SelectedVariable.Name,FallbackValue=PATH}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Process" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,8,7"/><TextBlock Grid.Column="1" Text="{Binding SelectedVariable.ProcessValue}" FontSize="10" TextWrapping="Wrap" Margin="0,0,14,7"/><TextBlock Grid.Column="2" Text="User" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,8,7"/><TextBlock Grid.Column="3" Text="{Binding SelectedVariable.UserValue}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBlock Grid.Row="1" Text="Machine" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,8,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVariable.MachineValue}" FontSize="10" TextWrapping="Wrap" Margin="0,0,14,0"/><TextBlock Grid.Row="1" Grid.Column="2" Text="Source" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,8,0"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedVariable.Source}" FontSize="10" TextWrapping="Wrap"/></Grid></StackPanel>
    <DockPanel Grid.Row="1" Margin="0,14,0,8"><TextBlock Text="PATH entries" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="{Binding PathEntries.Count, StringFormat={}{0} total}" Foreground="{DynamicResource MutedBrush}" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
    <DockPanel Grid.Row="2"><Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,9,0,0"><StackPanel><TextBlock Text="Resolve a command from process PATH" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,5"/><TextBox Text="{Binding ExecutableQuery,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Executable to resolve"/><TextBlock Text="{Binding ResolvedExecutable}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
     <ListBox ItemsSource="{Binding PathEntries}" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Ordered process PATH entries"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="Transparent" Padding="8,7" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Index}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Path}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock Text="{Binding Scope}" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding DisplayStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel>
   </Grid></Border>
  </Grid></Border>
 </Grid>
</UserControl>
