<Window x:Class="DevTools.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DevTools.App" xmlns:views="clr-namespace:DevTools.App.Views" xmlns:contracts="clr-namespace:DevTools.Contracts;assembly=DevTools.Contracts" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="DevTools Studio" Icon="/DevTools;component/Assets/DevTools.ico" Width="1180" Height="850" MinWidth="1024" MinHeight="700" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/><local:InverseBooleanConverter x:Key="InverseBoolean"/>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="{DynamicResource LineBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#A52216"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
    <DataTemplate x:Key="FieldTemplate"><StackPanel Width="318" Margin="0,0,18,20"><TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
      <Grid><TextBox x:Name="text" Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"/><PasswordBox x:Name="secret" Visibility="Collapsed" PasswordChanged="SecretChanged" Loaded="SecretLoaded" Unloaded="SecretUnloaded" DataContextChanged="SecretContextChanged" AutomationProperties.Name="{Binding Label}"/><ComboBox x:Name="choice" Visibility="Collapsed" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"/><CheckBox x:Name="toggle" Visibility="Collapsed" IsChecked="{Binding IsChecked}" Content="Enabled" AutomationProperties.Name="{Binding Label}"/><TextBlock x:Name="readOnly" Visibility="Collapsed" Text="{Binding Value}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Padding="0,5"/></Grid>
      <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding Kind}" Value="Choice"><Setter TargetName="text" Property="Visibility" Value="Collapsed"/><Setter TargetName="choice" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Secret"><Setter TargetName="text" Property="Visibility" Value="Collapsed"/><Setter TargetName="secret" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Toggle"><Setter TargetName="text" Property="Visibility" Value="Collapsed"/><Setter TargetName="toggle" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="ReadOnly"><Setter TargetName="text" Property="Visibility" Value="Collapsed"/><Setter TargetName="readOnly" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="PrimaryAction"><Button Content="{Binding Title}" Command="{Binding}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"><Button.Visibility><Binding Path="IsPrimary" Converter="{StaticResource BoolVisibility}"/></Button.Visibility></Button></DataTemplate>
    <DataTemplate x:Key="SecondaryAction"><Button Content="{Binding Title}" Command="{Binding}" Margin="0,0,10,10"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate>
  </Window.Resources>
  <Grid Background="{DynamicResource AppBackground}" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SidebarBackground}"><Grid Margin="20,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="AppLogo" Source="/DevTools;component/Assets/DevTools.png" Width="25" Height="25" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="DevTools Studio logo"/><TextBlock Text="DevTools" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/><TextBlock Text="STUDIO" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,2,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeClick" AutomationProperties.Name="Minimize"/><Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="MaximizeClick" AutomationProperties.Name="Maximize or restore"/><Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="CloseClick" AutomationProperties.Name="Close"/></StackPanel></Grid></Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="222"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel Margin="12,20,12,12"><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8"/><Button Command="{Binding NavigateCommand}" CommandParameter="{Binding SettingsPage}" HorizontalContentAlignment="Left" Margin="0,0,0,12"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="15,10"/><Style.Triggers><DataTrigger Binding="{Binding IsSettingsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/><TextBlock Text="Settings" FontSize="12"/></StackPanel></Button><TextBlock Margin="10,0,0,0" Text="●  Administrator session" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Text="Local tools. Your control." FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <views:SidebarNavigation/>
      </DockPanel></Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="138"/></Grid.RowDefinitions>
        <ScrollViewer Padding="32,25,28,22" VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding Selected.HasStartupAppsWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Selected.HasPreferencesWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Selected.HasScoopWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Selected.HasFolderWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Selected.HasBinaryInventoryWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><ContentControl Content="{Binding Selected}"><ContentControl.ContentTemplate><DataTemplate><StackPanel>
          <TextBlock Text="{Binding Group}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,18"/>
          <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,5,0,24" TextWrapping="Wrap"/>
          <Border x:Name="genericActions" Style="{StaticResource Panel}" Margin="0,0,0,18"><StackPanel><Grid><TextBlock Text="WORKSPACE STATUS" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="●  LOCAL" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessBrush}"/></Grid><TextBlock Text="{Binding Status}" FontSize="16" Margin="0,14,0,20" TextWrapping="Wrap"/><ProgressBar Value="{Binding Progress}" Maximum="100" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16"/>
            <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource PrimaryAction}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
            <Expander Header="Tools &amp; actions" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"><ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource SecondaryAction}" Margin="0,16,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Expander>
          </StackPanel></Border>
          <Border x:Name="form" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="CONFIGURATION" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,20"/><ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldTemplate}" IsEnabled="{Binding DataContext.IsBusy,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource InverseBoolean}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></Border>
          <views:StartSearchView x:Name="startSearchWorkspace" Visibility="Collapsed"/><views:WindowsWorkspaceView x:Name="windowsWorkspace" Visibility="Collapsed" IsEnabled="{Binding DataContext.IsBusy,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource InverseBoolean}}"/><views:IntegrationBrowserView x:Name="integrationBrowser" Visibility="Collapsed" IsEnabled="{Binding DataContext.IsBusy,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource InverseBoolean}}"/><ItemsControl x:Name="overview" Visibility="Collapsed" ItemsSource="{Binding DataContext.Pages,RelativeSource={RelativeSource AncestorType=Window}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="320" HorizontalContentAlignment="Left" Margin="0,0,12,12" Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><StackPanel Width="270"><TextBlock Text="{Binding Title}" FontSize="16"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding Id}" Value="overview"><Setter TargetName="form" Property="Visibility" Value="Collapsed"/><Setter TargetName="overview" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding HasIntegrationBrowser}" Value="True"><Setter TargetName="genericActions" Property="Visibility" Value="Collapsed"/><Setter TargetName="form" Property="Visibility" Value="Collapsed"/><Setter TargetName="integrationBrowser" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding HasStartSearchWorkspace}" Value="True"><Setter TargetName="genericActions" Property="Visibility" Value="Collapsed"/><Setter TargetName="form" Property="Visibility" Value="Collapsed"/><Setter TargetName="startSearchWorkspace" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding HasWindowsWorkspace}" Value="True"><Setter TargetName="genericActions" Property="Visibility" Value="Collapsed"/><Setter TargetName="form" Property="Visibility" Value="Collapsed"/><Setter TargetName="windowsWorkspace" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ContentControl.ContentTemplate></ContentControl></ScrollViewer><views:ScoopWorkspaceView DataContext="{Binding Selected}" Margin="32,22,28,16"><views:ScoopWorkspaceView.Style><Style TargetType="views:ScoopWorkspaceView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasScoopWorkspace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:ScoopWorkspaceView.Style></views:ScoopWorkspaceView>
        <views:StartupAppsView DataContext="{Binding Selected}" Margin="32,22,28,16"><views:StartupAppsView.Style><Style TargetType="views:StartupAppsView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasStartupAppsWorkspace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:StartupAppsView.Style></views:StartupAppsView>
        <views:WindowsPreferencesView DataContext="{Binding Selected}" Margin="32,22,28,16"><views:WindowsPreferencesView.Style><Style TargetType="views:WindowsPreferencesView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPreferencesWorkspace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:WindowsPreferencesView.Style></views:WindowsPreferencesView>
        <views:FolderInspectorView DataContext="{Binding Selected}" Margin="32,22,28,16"><views:FolderInspectorView.Style><Style TargetType="views:FolderInspectorView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFolderWorkspace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:FolderInspectorView.Style></views:FolderInspectorView><views:BinaryInventoryView DataContext="{Binding Selected}" Margin="32,22,28,16"><views:BinaryInventoryView.Style><Style TargetType="views:BinaryInventoryView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasBinaryInventoryWorkspace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:BinaryInventoryView.Style></views:BinaryInventoryView><Border Grid.Row="1" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,12,22,10"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="ACTIVITY" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button Content="Cancel operation" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Right" Padding="10,4" FontSize="11"/><TextBox Grid.Row="1" Text="{Binding Activity,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" BorderThickness="0" Padding="0,4" Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="LogChanged"/></Grid></Border>
      </Grid>
    </Grid>
    <Border x:Name="WorkspaceFooter" Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SidebarBackground}"><Grid Margin="18,0"><TextBlock Text="DevTools Studio · Windows workspace" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Text="LOCAL WORKSPACE" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
</Window>





